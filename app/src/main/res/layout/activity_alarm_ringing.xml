<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen alarm ringing: deep calm surface, huge time, prominent
     dismiss above snooze (the priority order of the two actions). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_ringing_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_icon_chip"
        android:contentDescription="@string/alarm_notification_title"
        android:padding="24dp"
        android:src="@drawable/ic_alarm"
        app:tint="@color/jarvis_status_thinking" />

    <!-- Autosize instead of a fixed 60sp: at fontScale 2.0 a fixed size
         overflows the screen, which is the one thing a ringing alarm must
         never do — the time is the whole message. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/jarvis_on_surface"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeMinTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        tools:text="07:30" />

    <TextView
        android:id="@+id/alarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/jarvis_on_surface_variant"
        android:textSize="20sp"
        tools:text="Подъём" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginTop="48dp"
        android:text="@string/dismiss"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnooze"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/button_min_height"
        android:layout_marginTop="12dp"
        android:text="@string/snooze"
        android:textSize="16sp" />
</LinearLayout>
