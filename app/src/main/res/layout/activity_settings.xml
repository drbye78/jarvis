<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Header (NoActionBar theme: we draw our own) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            style="@style/TextAppearance.Jarvis.ScreenTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Comfortable reading column on tablets: match_parent so it always
             fits the window; on windows wider than 760dp it is width-capped
             and centered in code (capColumnWidthOnWideScreens). -->
        <LinearLayout
            android:id="@+id/settingsColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- A0) LLM PROVIDER (GigaChat default, any OpenAI-compatible endpoint) -->
            <include
                layout="@layout/settings_card_llm_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                />

            <!-- A1) MUSIC: preferred default player -->
            <include
                layout="@layout/settings_card_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                />

            <!-- Weather: the configured city is the primary path (GMS-free,
                 WiFi-only devices); GPS auto-detect is the fallback. The card
                 also owns the location-permission prompt, which the weather
                 tool cannot show from the service. The pref is read live per
                 turn, so a saved city applies without a restart. -->
            <include
                layout="@layout/settings_card_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                />

            <!-- Maps: Yandex MapKit key for the geo lane (findPlace / getRoute).
                 The key is read once per app PROCESS, so the card states a full
                 app restart rather than the service restart the provider cards
                 use. Also carries the Yandex Maps attribution block. -->
            <include
                layout="@layout/settings_card_maps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                />

            <!-- Speech backend: Sber Salute / Yandex SpeechKit v3. Sits with
                 the other provider choice and directly above the credentials
                 card, which carries whichever keys that choice needs. -->
            <include
                layout="@layout/settings_card_speech_backend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                />

            <!-- A) PROVIDER CREDENTIALS -->
            <include
                layout="@layout/settings_card_credentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                />

            <!-- B) WAKE WORD -->
            <include
                layout="@layout/settings_card_wake_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- AEC: Phase A (hardware) + Phase B (software), opt-in -->
            <include
                layout="@layout/settings_card_aec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- Voice: TTS voice selection (applies live, no restart) -->
            <include
                layout="@layout/settings_card_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- Follow-up window: continue the dialogue without the wake word -->
            <include
                layout="@layout/settings_card_followup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- COGNITIVE_PLAN 1.8: the «Память» card — §12.4: every cognitive
                 default is the initial value of a user-visible switch. -->
            <include
                layout="@layout/settings_card_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- COGNITIVE_PLAN 2.6: the behaviour card (§12.4-1: the proactive
                 layer ships DEFAULT OFF; quiet hours + quota are user-tunable). -->
            <include
                layout="@layout/settings_card_behavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
