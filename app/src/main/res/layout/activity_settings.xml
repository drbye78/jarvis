<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings LIST host (settings redesign, FLIP lane). This is the new "category
  list" screen: a header, the apply-restart banner slot, the eight category rows
  and a tappable About row. It is the CONTENT of `SettingsActivity` and the
  entry point every caller already points at.

  Migrated from the designer's `settings_list_host.xml` (which is deleted so
  there is exactly one list host). The body is unchanged except for the two ids
  the nightly device suite hardcodes (`LayoutBoundsTest.kt`):
    - root   `settingsListRoot` -> `settingsRoot`
    - column `settingsListColumn` -> `settingsColumn`

  The 760 dp reading column is owned HERE by `settingsColumn`: the host applies
  `SETTINGS_COLUMN_MAX_WIDTH_DP` to that id so every row is capped and centred
  on tablets. Do not add full-bleed children outside `settingsColumn`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Header (NoActionBar theme: we draw our own), same idiom as the old host. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/settingsCloseButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            style="@style/TextAppearance.Jarvis.ScreenTitle" />
    </LinearLayout>

    <!-- Capped, centred reading column. Height 0dp + weight 1 so it fills the
         root under the header. -->
    <LinearLayout
        android:id="@+id/settingsColumn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Restart-needed notice. GONE until the host observes a pending
             ApplyPolicy; see settings_apply_banner.xml for the v1 rule (the
             banner instructs, it never relaunches the process). -->
        <include
            layout="@layout/settings_apply_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settingsCategoryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- The About row is NOT a category: it lives outside the RecyclerView so
             the adapter stays a pure projection of SettingsCategory.entries. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="?attr/colorSurfaceVariant" />

        <LinearLayout
            android:id="@+id/settingsAboutRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/settingsAboutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_about_title"
                style="@style/TextAppearance.Material3.TitleMedium" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/material_ic_keyboard_arrow_right_black_24dp"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
