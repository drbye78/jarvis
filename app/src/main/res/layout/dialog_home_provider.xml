<?xml version="1.0" encoding="utf-8"?>
<!--
  Add/edit smart-home connection form, shown inside an AlertDialog.

  The URL is validated as https before the dialog is allowed to close, and the
  rejection reason is shown on the URL field (see HomeProvidersActivity). The
  token is seeded from the vault and written back through
  CredentialsStore.setHomeSecret; it is never part of the persisted config blob.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/homeUrlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_home_provider_url_label"
            app:helperText="@string/settings_home_provider_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/homeUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/homeTokenStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/homeTokenLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/settings_home_provider_token_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/homeTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeTokenClearButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_home_provider_token_clear" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_home_provider_token_hint"
            style="@style/TextAppearance.Jarvis.Hint" />
    </LinearLayout>
</ScrollView>
