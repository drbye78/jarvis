<?xml version="1.0" encoding="utf-8"?>
<!--
  Add/edit smart-home connection form, shown inside an AlertDialog.

  PROVIDER-AWARE: the access block swaps between the two supported providers.
  Home Assistant uses a URL (validated https) + a long-lived token; Tuya uses a
  data-center region + the linked-account UID + the project's Access ID/Secret.
  The dialog-managing Activity shows/hides the blocks by provider.

  Secrets (the HA token, the Tuya Access Secret) are written through
  CredentialsStore.setHomeSecret and are never part of the persisted config blob.
  The region and UID are NON-secret and persist in HomeProviderConfig.metadata.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <!-- Provider picker — only shown when ADDING (editing keeps the provider). -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:id="@+id/homeProviderKindLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_home_provider_provider_label">

            <AutoCompleteTextView
                android:id="@+id/homeProviderKindInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= Home Assistant block ================= -->
        <LinearLayout
            android:id="@+id/homeHaBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/homeUrlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_url_label"
                app:helperText="@string/settings_home_provider_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/homeUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/homeTokenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_control_gap"
                style="@style/TextAppearance.Jarvis.Hint" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/homeTokenLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_token_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/homeTokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeTokenClearButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_provider_token_clear" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_home_provider_token_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- ================= Tuya block ================= -->
        <LinearLayout
            android:id="@+id/homeTuyaBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:id="@+id/homeTuyaRegionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_tuya_region_label">

                <AutoCompleteTextView
                    android:id="@+id/homeTuyaRegionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_home_provider_tuya_region_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/homeTuyaUidLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_tuya_uid_label"
                app:helperText="@string/settings_home_provider_tuya_uid_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/homeTuyaUidInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/homeTuyaAccessIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_tuya_access_id_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/homeTuyaAccessIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/homeTuyaSecretLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_home_provider_tuya_secret_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/homeTuyaSecretInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_home_provider_tuya_secret_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
