<?xml version="1.0" encoding="utf-8"?>
<!--
  Add/edit MCP server form, shown inside an AlertDialog.

  The URL is validated against the kind with McpUrlPolicy before the dialog is
  allowed to close, and the rejection reason is shown on the URL field (see
  McpServersActivity.rejectionRes). The secret is seeded from the vault and
  written back through CredentialsStore.setMcpSecret; it is never part of the
  persisted config blob.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/mcpNameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_mcp_name_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/mcpNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            android:text="@string/settings_mcp_kind_label"
            style="@style/TextAppearance.Jarvis.Hint" />

        <RadioGroup
            android:id="@+id/mcpKindGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mcpKindRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_mcp_kind_remote" />

            <RadioButton
                android:id="@+id/mcpKindLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_mcp_kind_local" />

            <RadioButton
                android:id="@+id/mcpKindLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_mcp_kind_lan" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/mcpUrlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            android:hint="@string/settings_mcp_url_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/mcpUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/mcpAuthHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            android:hint="@string/settings_mcp_auth_header_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/mcpAuthHeaderInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/mcpSecretLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            android:hint="@string/settings_mcp_secret_label"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/mcpSecretInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap"
            android:text="@string/settings_mcp_access_label"
            style="@style/TextAppearance.Jarvis.Hint" />

        <RadioGroup
            android:id="@+id/mcpAccessGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mcpAccessRead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_mcp_access_read" />

            <RadioButton
                android:id="@+id/mcpAccessWrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_mcp_access_write" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
