<?xml version="1.0" encoding="utf-8"?>
<!--
  «Аккаунты и ключи» / ACCOUNTS detail screen (settings redesign, F-E).

  Replaces the placeholder. Source material: settings_card_credentials.xml
  (all provider keys) PLUS the [OI]-compatible API key relocated here from
  settings_card_llm_provider.xml (its URL + model stay on BRAIN).

  NO DISCLOSURE on this screen (frozen design decision): a disclosure is used
  only when a screen has BOTH essential and advanced content, and every row
  here is an access key — hiding them would empty the screen.

  Keys are grouped by provider, each under a section heading:
    1. Picovoice (optional; needed only by the Porcupine engine)
    2. Sber Salute  — client id + secret (validated live)
    3. Yandex       — one Cloud API key (shared speech + AI Studio LLM)
    4. GigaChat     — client id + secret (validated live)
    5. [OI]-compatible endpoint API key (URL/model live on BRAIN)
    6. check + save actions

  FROZEN IDS (must not be renamed): picovoiceKeyLayout, picovoiceKey,
  sberCredentialsBlock, saluteIdLayout, saluteId, saluteSecretLayout,
  saluteSecret, yandexCredentialsBlock, yandexApiKeyLayout, yandexApiKey,
  gigaChatIdLayout, gigaChatId, gigaChatSecretLayout, gigaChatSecret,
  gigaChatCheckStatus, checkCredentialsButton, saveCredentialsButton,
  openAiApiKeyLayout, openAiApiKey.

  NEW ID introduced by this screen (controller contract): saluteCheckStatus
  (the live Salute verdict row, symmetric with gigaChatCheckStatus).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsAccountsScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credentials_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/credentials_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- Picovoice (optional; only the Porcupine engine consumes it). -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/picovoiceKeyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/picovoice_key_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/picovoiceKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sber SaluteSpeech: client id + secret. The live verdict renders
             under the pair (split-field write-back keeps the halves honest). -->
        <LinearLayout
            android:id="@+id/sberCredentialsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/speech_backend_sber"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/saluteIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/salute_id_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/saluteId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/saluteSecretLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/salute_secret_label"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/saluteSecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/saluteCheckStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- Yandex Cloud: one API key (shared with the AI Studio LLM). No
             folder id here — it lives on BRAIN. -->
        <LinearLayout
            android:id="@+id/yandexCredentialsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/provider_yandex"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/yandexApiKeyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/yandex_api_key_label"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/yandexApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/yandex_api_key_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- GigaChat (LLM): client id + secret, validated live. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/provider_gigachat"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/gigaChatIdLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/gigachat_id_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gigaChatId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/gigaChatSecretLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/gigachat_secret_label"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gigaChatSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/gigaChatCheckStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- [OI]-compatible endpoint API key. Its URL + model live on BRAIN;
             this screen owns ONLY the key, so saving must reuse the stored
             URL/model/folder rather than blanking them. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/provider_openai_compat"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/openAiApiKeyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/api_key_label"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/openAiApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Immediate re-validation of both mandatory pairs. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkCredentialsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/credentials_check_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
