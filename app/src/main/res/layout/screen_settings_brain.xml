<?xml version="1.0" encoding="utf-8"?>
<!--
  «Помощник» / BRAIN detail screen (settings redesign, D1 — pattern-setting).

  Replaces the placeholder. Source material: settings_card_llm_provider.xml,
  with the [OI] API key relocated to ACCOUNTS per the frozen contract.

  ORDERING (essential -> advanced), see SETTINGS_SCREEN_PATTERN.md:
    1. provider radio group                        (essential)
    2. the selected provider's model block         (essential)
       + a READ-ONLY credential status row         (mitigation: the secret
         lives on ACCOUNTS, so this row says where it went and taps through)
    3. «Дополнительно» disclosure                  (only when the provider has
       advanced settings)
    4. advanced container:
       - yandexFolderId                           (advanced, Yandex only)
       - openAiBlock: base URL + model            (advanced, [OI] only)
    5. saveProviderButton                          (always visible)

  FROZEN IDS (must not be renamed): llmProviderGroup, providerGigachat,
  providerOpenai, providerYandex, gigaChatBlock, gigaChatModelGroup,
  gigaChatModelLightning, gigaChatModelPro, gigaChatModelUltra, yandexBlock,
  yandexModelGroup, yandexModelAlice, yandexModelAliceFlash, yandexModelYandexGpt,
  yandexFolderIdLayout, yandexFolderId, openAiBlock, openAiBaseUrlLayout,
  openAiBaseUrl, openAiModelLayout, openAiModel, saveProviderButton.

  NEW IDS introduced by this screen (controller contract): gigaChatCredentialStatus,
  yandexCredentialStatus, openAiCredentialStatus, settingsBrainAdvanced.
  Disclosure ids come from settings_disclosure.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsBrainScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provider_label"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <RadioGroup
            android:id="@+id/llmProviderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/providerGigachat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_gigachat" />

            <RadioButton
                android:id="@+id/providerOpenai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_openai_compat" />

            <RadioButton
                android:id="@+id/providerYandex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_yandex" />
        </RadioGroup>

        <!-- GigaChat model (essential). The client is built from ProviderSettings
             at service start, so the banner reports the restart requirement; the
             old per-card restart paragraph is intentionally dropped here. -->
        <LinearLayout
            android:id="@+id/gigaChatBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gigachat_model_label"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gigachat_model_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <RadioGroup
                android:id="@+id/gigaChatModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/gigaChatModelLightning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_lightning" />

                <RadioButton
                    android:id="@+id/gigaChatModelPro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_pro" />

                <RadioButton
                    android:id="@+id/gigaChatModelUltra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_ultra" />
            </RadioGroup>

            <!-- Read-only credential status. The GigaChat secret lives on the
                 ACCOUNTS screen; this row reports whether it is set and taps
                 through. It deliberately does NOT duplicate the input. Default
                 text is the neutral "manage" label so an unbound row never
                 states a false status. -->
            <TextView
                android:id="@+id/gigaChatCredentialStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/settings_brain_key_manage"
                android:drawableEnd="@drawable/material_ic_keyboard_arrow_right_black_24dp"
                android:drawableTint="?attr/colorPrimary"
                android:drawablePadding="8dp"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="Ключ не задан · Управление ключами" />
        </LinearLayout>

        <!-- Yandex AI Studio model (essential). The API key is shared with
             SpeechKit and lives on ACCOUNTS; status row as above. -->
        <LinearLayout
            android:id="@+id/yandexBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yandex_model_label"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/yandex_model_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <RadioGroup
                android:id="@+id/yandexModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/yandexModelAlice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_aliceai_llm" />

                <RadioButton
                    android:id="@+id/yandexModelAliceFlash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_aliceai_llm_flash" />

                <RadioButton
                    android:id="@+id/yandexModelYandexGpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_yandexgpt_5_lite" />
            </RadioGroup>

            <TextView
                android:id="@+id/yandexCredentialStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/settings_brain_key_manage"
                android:drawableEnd="@drawable/material_ic_keyboard_arrow_right_black_24dp"
                android:drawableTint="?attr/colorPrimary"
                android:drawablePadding="8dp"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="Ключ не задан · Управление ключами" />
        </LinearLayout>

        <!-- Advanced. Hidden until tapped; the controller shows this row only
             when the active provider has advanced settings and sets the count. -->
        <include
            layout="@layout/settings_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/settingsBrainAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Yandex folder id (advanced, Yandex only). Moved OUT of
                 yandexBlock so it can hide behind the disclosure while the
                 model radios stay essential. The controller gates BOTH
                 yandexBlock and this layout on the provider pref. -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/yandexFolderIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/yandex_folder_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/yandexFolderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/yandex_folder_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <!-- [OI]-compatible endpoint (advanced, [OI] only). All of its
                 content is advanced, which is why the controller should
                 AUTO-EXPAND the advanced section when the provider is
                 OPENAI_COMPAT. The OI API key is on ACCOUNTS. -->
            <LinearLayout
                android:id="@+id/openAiBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:id="@+id/openAiBaseUrlLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/base_url_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/openAiBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:id="@+id/openAiModelLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/model_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/openAiModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/openAiCredentialStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/settings_brain_key_manage"
                    android:drawableEnd="@drawable/material_ic_keyboard_arrow_right_black_24dp"
                    android:drawableTint="?attr/colorPrimary"
                    android:drawablePadding="8dp"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorPrimary"
                    tools:text="Ключ не задан · Управление ключами" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary action, always visible (the old layout buried it inside the
             [OI] block). The controller must pass the STORED openAiApiKey so it
             cannot wipe the key this screen no longer displays. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveProviderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
