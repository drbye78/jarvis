<?xml version="1.0" encoding="utf-8"?>
<!--
  «Слушание» / LISTENING detail screen (settings redesign, D1 — pattern-setting).

  Replaces the placeholder. Source material: settings_card_wake_word.xml +
  settings_card_aec.xml + settings_card_followup.xml, merged into ONE screen
  with sections. This is the pattern case where three old cards become one
  screen and MOST rows move behind «Дополнительно».

  ORDERING (essential -> advanced), see SETTINGS_SCREEN_PATTERN.md:
    1. «Диалог» section   (essential): voice stop + follow-up switch
    2. «Дополнительно» disclosure
    3. advanced container, grouped by feature so the old cards stay legible:
       - «Активация»: engine, wake word, custom keyword, sensitivity
       - «Эхоподавление»: AEC mode + playback-capture grant
       - «Продолжение диалога»: the follow-up window slider

  FROZEN IDS (must not be renamed): engineGroup, enginePorcupine, engineSherpa,
  porcupineBlock, wakeWordGroup, wakeBuiltin, wakeCustomBundled, loadCustomButton,
  sherpaBlock, sherpaKeywordInput, sherpaKeywordStatus, voiceStopSwitch,
  sensitivityValue, sensitivityBar, aecGroup, aecOff, aecHardware, aecSoftware,
  aecProbeRow, aecSoftwareHint, aecCaptureSwitch, aecCaptureGrant, followUpSwitch,
  followUpValue, followUpBar.

  NEW ID introduced by this screen (controller contract): settingsListeningAdvanced.
  Disclosure ids come from settings_disclosure.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsListeningScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_listening_dialogue_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <!-- Voice stop lives OUTSIDE the engine-conditional blocks: the pref
             drives both engines, so it must be visible either way. It is also
             essential, so it stays above the disclosure. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/voiceStopSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voice_stop_toggle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_stop_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/followUpSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/followup_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/followup_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <include
            layout="@layout/settings_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/settingsListeningAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Section: ACTIVATION. Movement during the redesign: the wake-word
                 engine/model used to be the first thing on a card whose screen is
                 literally named "Listening"; per the frozen level table they are
                 advanced and now sit behind the disclosure. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_listening_activation_section"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/engine_label"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/engineGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/enginePorcupine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/engine_porcupine" />

                <RadioButton
                    android:id="@+id/engineSherpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/engine_sherpa" />
            </RadioGroup>

            <!-- Porcupine controls (hidden when Sherpa-ONNX is active). -->
            <LinearLayout
                android:id="@+id/porcupineBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/porcupine_hint"
                    style="@style/TextAppearance.Jarvis.Hint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wake_word_section"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/wakeWordGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/wakeBuiltin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/wake_word_builtin" />

                    <RadioButton
                        android:id="@+id/wakeCustomBundled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/wake_word_custom_bundled" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loadCustomButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/load_custom_wake_word" />
            </LinearLayout>

            <!-- Sherpa-ONNX controls (hidden when Porcupine is active). -->
            <LinearLayout
                android:id="@+id/sherpaBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sherpa_hint"
                    style="@style/TextAppearance.Jarvis.Hint" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/sherpa_keyword_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sherpaKeywordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/sherpaKeywordStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    style="@style/TextAppearance.Jarvis.Hint" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sensitivity"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sensitivityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/TextAppearance.Jarvis.Hint" />

            <SeekBar
                android:id="@+id/sensitivityBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <!-- Section: ECHO CANCELLATION. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/aec_section"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <RadioGroup
                android:id="@+id/aecGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/aecOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aec_off" />

                <RadioButton
                    android:id="@+id/aecHardware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aec_hardware" />

                <RadioButton
                    android:id="@+id/aecSoftware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aec_software" />
            </RadioGroup>

            <TextView
                android:id="@+id/aecProbeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/TextAppearance.Jarvis.Hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/aec_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <TextView
                android:id="@+id/aecSoftwareHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aec_software_hint"
                android:visibility="gone"
                style="@style/TextAppearance.Jarvis.Hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/aec_capture_section"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/aecCaptureSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aec_capture_switch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aecCaptureGrant"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/aec_capture_grant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aec_capture_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <!-- Section: FOLLOW-UP WINDOW. The switch stays essential above;
                 its length is advanced and lives here. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/followup_section"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/followUpValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/TextAppearance.Jarvis.Hint" />

            <SeekBar
                android:id="@+id/followUpBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
