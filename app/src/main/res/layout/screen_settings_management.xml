<?xml version="1.0" encoding="utf-8"?>
<!--
  «Управление» / MANAGEMENT detail screen (R13 §14, Wave 1).

  SETTINGS + DISPLAY ONLY. The management server is NOT wired here — a later
  wave owns the listener. This screen persists the mode/port/idle timeout,
  shows the certificate fingerprint and offers the one-time password reveal.

  CONTRACT-TABLE PLACEMENT (see SETTINGS_INVENTORY.md):
    - managementMode / managementPort  SERVICE_RESTART (the listener binds a
      specific interface:port). The restart hint below states it.
    - managementIdleTimeoutMs          LIVE (read per request by the server).

  FROZEN IDS (controller contract, referenced by ManagementSettingsController):
  managementModeGroup, managementModeDisabled, managementModeLocalhost,
  managementModeLan, managementPortInput, managementPortSaveButton,
  managementIdleInput, managementIdleSaveButton, managementStatusValue,
  managementStatusDetail, managementToggleButton, managementPasswordValue,
  managementShowPasswordButton.

  All ids are prefixed `management` so they can never collide with another
  screen's ids (SettingsLayoutTest asserts id uniqueness across screens).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsManagementScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_management_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_info"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- Live status + explicit activate/deactivate. The radio above is the
             persisted INTENT; the button applies it to the running listener
             through ManagementServerProvider (process-scoped). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/settings_management_status_label"
            style="@style/TextAppearance.Jarvis.Hint" />

        <TextView
            android:id="@+id/managementStatusValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_management_status_stopped"
            style="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/managementStatusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            style="@style/TextAppearance.Material3.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/managementToggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_before_action"
            android:text="@string/settings_management_activate" />

        <!-- Mode: the persisted user INTENT. The socket is only open when the
             service decides the mode is active; a reboot always drops LAN. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_management_mode_label"
            style="@style/TextAppearance.Jarvis.Hint" />

        <RadioGroup
            android:id="@+id/managementModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap">

            <RadioButton
                android:id="@+id/managementModeDisabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_management_mode_disabled" />

            <RadioButton
                android:id="@+id/managementModeLocalhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_management_mode_localhost" />

            <RadioButton
                android:id="@+id/managementModeLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_management_mode_lan" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_mode_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- Port: sealed when the listener binds, hence the restart hint. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/managementPortInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:hint="@string/settings_management_port_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/managementPortInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_port_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/managementPortSaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_before_action"
            android:text="@string/save" />

        <!-- Idle timeout: LIVE (read per request), so no restart hint. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/managementIdleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:hint="@string/settings_management_idle_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/managementIdleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_idle_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/managementIdleSaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_before_action"
            android:text="@string/save" />

        <!-- Apply policy for mode/port: the server is graph/FGS-owned, so the
             bind change needs a service restart. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_apply_service_restart"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- Security: honest warnings + the fingerprint to verify the browser
             warning + the one-time password reveal. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/settings_management_security_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_lan_warning"
            style="@style/TextAppearance.Jarvis.Hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_tls_warning"
            style="@style/TextAppearance.Jarvis.Hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_management_password_label"
            style="@style/TextAppearance.Jarvis.Hint" />

        <TextView
            android:id="@+id/managementPasswordValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="@string/settings_management_password_hidden"
            style="@style/TextAppearance.Material3.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/managementShowPasswordButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_management_password_show" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_management_password_hint"
            style="@style/TextAppearance.Jarvis.Hint" />
    </LinearLayout>
</ScrollView>
