<?xml version="1.0" encoding="utf-8"?>
<!--
  «Музыка» / MUSIC detail screen (settings redesign, F-C).

  Replaces the placeholder. Source material: settings_card_music.xml.

  All content is ESSENTIAL (contract table: `preferredMusicPlayer` is the only
  row and it is essential), so there is deliberately NO disclosure here — see
  SETTINGS_SCREEN_PATTERN.md §6/§8.

  FROZEN IDS (must not be renamed): playerGroup, playerAuto, playerYandex,
  playerZvuk, playerVk. No new ids are introduced by this screen.

  The change is read lazily by the composition root on every resolve, so it
  applies to the NEXT voice command — LIVE, no restart, no banner.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsMusicScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <RadioGroup
            android:id="@+id/playerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/playerAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/player_auto" />

            <RadioButton
                android:id="@+id/playerYandex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/player_yandex" />

            <RadioButton
                android:id="@+id/playerZvuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/player_zvuk" />

            <RadioButton
                android:id="@+id/playerVk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/player_vk" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/player_hint"
            style="@style/TextAppearance.Jarvis.Hint" />
    </LinearLayout>
</ScrollView>
