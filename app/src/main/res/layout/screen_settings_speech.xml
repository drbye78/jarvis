<?xml version="1.0" encoding="utf-8"?>
<!--
  «Речь» / SPEECH detail screen (settings redesign, F-C).

  Replaces the placeholder. Source material: settings_card_speech_backend.xml +
  settings_card_voice.xml, merged into ONE screen with sections.

  ORDERING (essential -> advanced), see SETTINGS_SCREEN_PATTERN.md:
    1. «Синтез и распознавание» section (essential): backend radios
    2. «Голос» section (essential): the active backend's voice block
       - Sber: preset / custom voice + free-text ID
       - Yandex: the closed voice dropdown
    3. «Дополнительно» disclosure            (shown only when the active backend's
                                               capabilities expose an advanced
                                               entry: Yandex role and/or speed)
    4. advanced container: the Yandex ROLE and SPEED (advanced, capability-gated;
       the role additionally requires the selected voice to document roles)
    5. voiceTestButton                       (always visible)

  FROZEN IDS (must not be renamed): speechBackendGroup, speechBackendSber,
  speechBackendYandex, sberVoiceBlock, voiceGroup, voiceMila, voiceCustom,
  voiceCustomInput, voiceCustomId, yandexVoiceBlock, yandexVoiceLayout,
  yandexVoice, yandexRoleLayout, yandexRole, voiceTestButton.

  NEW IDS introduced by this screen (controller contract): settingsSpeechAdvanced,
  yandexSpeedBlock, yandexSpeedLabel, yandexSpeedValue, yandexSpeedBar.
  Disclosure ids come from settings_disclosure.xml.

  The per-card restart paragraph is intentionally dropped: the host banner now
  carries the SERVICE_RESTART notice (PendingChanges), same as the BRAIN screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsSpeechScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speech_backend_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <!-- One choice drives BOTH recognition and synthesis: they are one
             product decision, and splitting them could pair a Sber voice ID
             with the Yandex client. The choice is sealed at graph
             construction, so the host banner reports the restart need. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/speech_backend_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <RadioGroup
            android:id="@+id/speechBackendGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_control_gap">

            <RadioButton
                android:id="@+id/speechBackendSber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/speech_backend_sber" />

            <RadioButton
                android:id="@+id/speechBackendYandex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/speech_backend_yandex" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/voice_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <!-- Sber voices (essential), shown only while the Sber backend is
             active. Visibility only: the hidden block keeps its values, so
             switching back and forth never discards a chosen voice. -->
        <LinearLayout
            android:id="@+id/sberVoiceBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/voiceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/voiceMila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/voice_mila" />

                <RadioButton
                    android:id="@+id/voiceCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/voice_custom" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/voiceCustomInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/voice_custom_hint_field"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/voiceCustomId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/voice_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- Yandex voice (essential), gated on the Yandex backend. The voice
             list is a documented, closed set, so it is a real dropdown. The
             ROLE and SPEED live behind the disclosure as the screen's
             capability-gated advanced entries. -->
        <LinearLayout
            android:id="@+id/yandexVoiceBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:id="@+id/yandexVoiceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/yandex_voice_label">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/yandexVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/yandex_voice_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- The advanced entries are the Yandex ROLE and SPEED, so the controller
             shows this row only when the active backend's capabilities expose at
             least one of them (the count is derived) and hides it otherwise. -->
        <include
            layout="@layout/settings_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/settingsSpeechAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Yandex role (advanced, capability-gated). CLOSED dropdown: the
                 presets are only the roles the selected voice DOCUMENTS. The
                 field is non-editable — free text would persist a pair the
                 service rejects. An empty selection means "no role".

                 Do NOT override endIconMode here. The ExposedDropdownMenu style
                 sets `dropdown_menu`, and THAT is what installs the tap-to-open
                 listener on the AutoCompleteTextView; overriding it with
                 `clear_text` silently removed the dropdown and left a field
                 that looked like plain input. "No role" is a leading list entry
                 handled in the controller, not a clear icon. -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:id="@+id/yandexRoleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/yandex_role_label">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/yandexRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Yandex speaking rate (advanced, capability-gated). Persisted LIVE;
                 the UI range is narrower than the 0.1..3.0 the storage validates
                 (the 20 s per-sentence timeout truncates a long sentence at the
                 extremes). -->
            <LinearLayout
                android:id="@+id/yandexSpeedBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yandexSpeedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yandex_speed_label"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yandexSpeedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    style="@style/TextAppearance.Jarvis.Hint"
                    tools:text="1.0x" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/yandexSpeedBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:stepSize="0.1" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceTestButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_before_action"
            android:text="@string/voice_test_button" />
    </LinearLayout>
</ScrollView>
