<?xml version="1.0" encoding="utf-8"?>
<!--
  «Погода и карты» / WEATHER_MAPS detail screen (settings redesign, F-D).

  Replaces the placeholder. Source material: settings_card_weather.xml +
  settings_card_maps.xml, merged into ONE screen with sections.

  ORDERING (essential -> advanced), see SETTINGS_SCREEN_PATTERN.md:
    1. «Погода» section   (essential): default city + permission affordance
    2. «Карты» section    (essential): the Yandex Maps attribution + the two
       legal/entry links. They are ALWAYS on screen because they are the
       licensing mitigation, not a setting — keeping them out of the advanced
       section is deliberate.
    3. «Дополнительно» disclosure (count = 1: the MapKit key)
    4. advanced container: the MapKit API key (process-scoped, APP_RESTART)

  The configured city always WINS over GPS; the hint says so. No string in this
  file promises that GPS overrides a configured city.

  FROZEN IDS (must not be renamed): weatherLocationInputLayout,
  weatherLocationInput, weatherLocationSaveButton,
  weatherLocationPermissionButton, weatherLocationPermissionStatus,
  mapKitApiKeyLayout, mapKitApiKey, mapKitApiKeySaveButton, mapKitTermsButton,
  mapKitOpenMapsButton.

  NEW ID introduced by this screen (controller contract):
  settingsWeatherMapsAdvanced. Disclosure ids come from settings_disclosure.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsWeatherMapsScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Section: WEATHER. The configured city is the primary path on
             GMS-free, WiFi-only devices; the permission grant is secondary. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_card_title"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/weatherLocationInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/weather_location_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/weatherLocationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The configured city WINS over GPS; the hint states that priority. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/weather_location_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weatherLocationSaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save" />

        <!-- The weather tool runs in the service and cannot show a permission
             dialog, so this screen owns the only affordance. Secondary to the
             city: a configured city never needs the grant. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/weatherLocationPermissionButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/weather_permission_request" />

        <!-- Filled in code from the live grant; GONE when a configured city
             makes the grant irrelevant (see SettingsMapping). -->
        <TextView
            android:id="@+id/weatherLocationPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            style="@style/TextAppearance.Jarvis.Hint" />

        <!-- Section: MAPS. The attribution block below is the licensing
             mitigation and stays essential (always visible). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/maps_card_title"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/maps_attribution"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapKitTermsButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/maps_terms_link" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapKitOpenMapsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/maps_open_maps" />

        <!-- Advanced. The ONLY advanced entry here is the MapKit key. -->
        <include
            layout="@layout/settings_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/settingsWeatherMapsAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- A SEPARATE secret from the SpeechKit/AI Studio key. Read once
                 per app PROCESS, so the hint states a full app restart
                 (stricter than the provider cards' service restart). -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/mapKitApiKeyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/maps_api_key_label"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mapKitApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/maps_api_key_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapKitApiKeySaveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
