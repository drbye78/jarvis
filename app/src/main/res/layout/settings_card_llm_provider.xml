<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings card extracted from activity_settings.xml (U1). The card keeps its own
  android:layout_width/layout_height so this file is a valid, standalone layout, and
  the per-card margins live on the <include> tag in the host (they legitimately differ
  per card). Every id declared here is checked by SettingsLayoutTest, which ties the
  host, these includes and SettingsActivity's findViewById calls together.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Jarvis.SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/provider_label"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/llmProviderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/providerGigachat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_gigachat" />

            <RadioButton
                android:id="@+id/providerOpenai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_openai_compat" />

            <RadioButton
                android:id="@+id/providerYandex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/provider_yandex" />
        </RadioGroup>

        <!-- GigaChat-3 flavor (visible only while GigaChat is selected).
             Mirror of the OpenAI block below, and the same rule applies: the
             client is built from ProviderSettings at service start, so the
             flavor is sealed at graph construction and the restart note
             repeats the provider card's wording. -->
        <LinearLayout
            android:id="@+id/gigaChatBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gigachat_model_label"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gigachat_model_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <RadioGroup
                android:id="@+id/gigaChatModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/gigaChatModelLightning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_lightning" />

                <RadioButton
                    android:id="@+id/gigaChatModelPro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_pro" />

                <RadioButton
                    android:id="@+id/gigaChatModelUltra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gigachat_model_ultra" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/provider_restart_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- Yandex AI Studio (visible only while it is selected). Same rule as
             the two blocks around it: the client is built from ProviderSettings
             at service start, so the choice is sealed at graph construction.
             The API key is deliberately NOT repeated here — it lives in the
             credentials card, where the one key already serves the speech
             engine too. -->
        <LinearLayout
            android:id="@+id/yandexBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yandex_model_label"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/yandex_model_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <RadioGroup
                android:id="@+id/yandexModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/yandexModelAlice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_aliceai_llm" />

                <RadioButton
                    android:id="@+id/yandexModelAliceFlash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_aliceai_llm_flash" />

                <RadioButton
                    android:id="@+id/yandexModelYandexGpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/yandex_model_yandexgpt_5_lite" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/yandexFolderIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/yandex_folder_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/yandexFolderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/yandex_folder_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/provider_restart_hint"
                style="@style/TextAppearance.Jarvis.Hint" />
        </LinearLayout>

        <!-- OpenAI-compatible endpoint fields (visible only when selected) -->
        <LinearLayout
            android:id="@+id/openAiBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/openAiBaseUrlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/base_url_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/openAiBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/openAiModelLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/model_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/openAiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/openAiApiKeyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/api_key_label"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/openAiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/provider_restart_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveProviderButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
