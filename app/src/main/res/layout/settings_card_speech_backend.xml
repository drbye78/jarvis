<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings card extracted from activity_settings.xml (U1). The card keeps its own
  android:layout_width/layout_height so this file is a valid, standalone layout, and
  the per-card margins live on the <include> tag in the host (they legitimately differ
  per card). Every id declared here is checked by SettingsLayoutTest, which ties the
  host, these includes and SettingsActivity's findViewById calls together.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Jarvis.SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/speech_backend_section"
                style="@style/TextAppearance.Jarvis.SectionHeader"
                android:accessibilityHeading="true" />
        </LinearLayout>

        <!-- One choice drives BOTH recognition and synthesis: they are one
             product decision ("who hears and speaks for me"), and splitting
             them would let a half-migrated install send a Sber voice ID to
             Yandex. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/speech_backend_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <RadioGroup
            android:id="@+id/speechBackendGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/speechBackendSber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/speech_backend_sber" />

            <RadioButton
                android:id="@+id/speechBackendYandex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/speech_backend_yandex" />
        </RadioGroup>

        <!-- The backend is sealed at graph construction: each provider has its
             own channel and its own auth scheme, so this genuinely cannot be
             applied to a running service. Same rule (and same wording) as the
             LLM provider card. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/provider_restart_hint"
            style="@style/TextAppearance.Jarvis.Hint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
