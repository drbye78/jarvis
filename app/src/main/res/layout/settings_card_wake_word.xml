<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings card extracted from activity_settings.xml (U1). The card keeps its own
  android:layout_width/layout_height so this file is a valid, standalone layout, and
  the per-card margins live on the <include> tag in the host (they legitimately differ
  per card). Every id declared here is checked by SettingsLayoutTest, which ties the
  host, these includes and SettingsActivity's findViewById calls together.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Jarvis.SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wake_word_section"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <!-- Engine selector: Porcupine vs Sherpa-ONNX -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/engine_label"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/engineGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/enginePorcupine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/engine_porcupine" />

            <RadioButton
                android:id="@+id/engineSherpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/engine_sherpa" />
        </RadioGroup>

        <!-- Porcupine controls (hidden when Sherpa-ONNX is active) -->
        <LinearLayout
            android:id="@+id/porcupineBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/porcupine_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <RadioGroup
                android:id="@+id/wakeWordGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/wakeBuiltin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/wake_word_builtin" />

                <RadioButton
                    android:id="@+id/wakeCustomBundled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/wake_word_custom_bundled" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loadCustomButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/load_custom_wake_word" />
        </LinearLayout>

        <!-- Sherpa-ONNX controls (hidden when Porcupine is active) -->
        <LinearLayout
            android:id="@+id/sherpaBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sherpa_hint"
                style="@style/TextAppearance.Jarvis.Hint" />

            <!-- FIXPLAN C: custom wake keyword (English word/short
                 phrase the bundled BPE model can encode). Validated
                 live with the real tokenizer; applied on IME done
                 or focus loss. -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/sherpa_keyword_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sherpaKeywordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/sherpaKeywordStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                style="@style/TextAppearance.Jarvis.Hint" />

        </LinearLayout>

        <!-- FIXPLAN B: voice stop while the assistant speaks.
             Lives OUTSIDE the engine-conditional blocks: the
             pref drives WakeWordRequest.stopPhraseEnabled for
             BOTH engines, so the switch must be visible whether
             Porcupine or Sherpa-ONNX is selected. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/voiceStopSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_stop_toggle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_stop_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sensitivity"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sensitivity_value"
            style="@style/TextAppearance.Jarvis.Hint" />

        <SeekBar
            android:id="@+id/sensitivityBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
