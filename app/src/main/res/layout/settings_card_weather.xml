<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings card extracted from activity_settings.xml (U1). The card keeps its own
  android:layout_width/layout_height so this file is a valid, standalone layout, and
  the per-card margins live on the <include> tag in the host (they legitimately differ
  per card). Every id declared here is checked by SettingsLayoutTest, which ties the
  host, these includes and SettingsActivity's findViewById calls together.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Jarvis.SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weather_card_title"
            style="@style/TextAppearance.Jarvis.SectionHeader"
            android:accessibilityHeading="true" />

        <!-- The configured city is the primary path on GMS-free, WiFi-only
             devices; GPS auto-detect is the fallback. It is the first control
             in the card for that reason, and the hint repeats that a city
             always wins. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/weatherLocationInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/weather_location_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/weatherLocationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/weather_location_hint"
            style="@style/TextAppearance.Jarvis.Hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weatherLocationSaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save" />

        <!-- The weather tool runs in the service and cannot show a permission
             dialog, so this card owns the only affordance. Secondary to the
             city: a configured city never needs the grant. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/weatherLocationPermissionButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/weather_permission_request" />

        <!-- Filled in code from the live grant; GONE when a configured city
             makes the grant irrelevant (see SettingsMapping). -->
        <TextView
            android:id="@+id/weatherLocationPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            style="@style/TextAppearance.Jarvis.Hint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
