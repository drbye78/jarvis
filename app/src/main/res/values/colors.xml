<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Jarvis design tokens — DAY.
         "Arc-reactor teal" primary + warm amber accent; alarm surfaces stay
         calm and dark. Every color exists as a night twin in values-night/. -->
    <color name="jarvis_primary">#00695C</color>
    <color name="jarvis_on_primary">#FFFFFF</color>
    <color name="jarvis_primary_container">#B2F1E8</color>
    <color name="jarvis_on_primary_container">#00201C</color>

    <color name="jarvis_secondary">#7A5900</color>
    <color name="jarvis_on_secondary">#FFFFFF</color>
    <color name="jarvis_secondary_container">#FFDF9E</color>
    <color name="jarvis_on_secondary_container">#261A00</color>

    <color name="jarvis_surface">#F6FAF9</color>
    <color name="jarvis_on_surface">#171D1C</color>
    <color name="jarvis_surface_variant">#DAE5E2</color>
    <color name="jarvis_on_surface_variant">#3F4947</color>
    <color name="jarvis_outline">#6F7977</color>

    <color name="jarvis_background">#F6FAF9</color>

    <color name="jarvis_error">#BA1A1A</color>
    <color name="jarvis_on_error">#FFFFFF</color>
    <color name="jarvis_error_container">#FFDAD6</color>
    <color name="jarvis_on_error_container">#410002</color>

    <!-- Semantic status colors (VoiceOrb + status pill).
         WCAG-checked in StatusContrastTest: each is a large graphic (>= 3:1)
         against jarvis_background; listening/thinking double as Settings status
         text on jarvis_surface, where they must reach 4.5:1. The day
         listening/speaking pair separates by LIGHTNESS (L* 45 vs 31), not hue
         alone, so the states are tellable apart at a 2-4 m glance. -->
    <color name="jarvis_status_idle">#4E6B66</color>
    <color name="jarvis_status_listening">#00796B</color>
    <color name="jarvis_status_thinking">#8A5600</color>
    <color name="jarvis_status_speaking">#054987</color>

    <!-- Thinking-state accent: 2dp border drawn around the status pill while
         the assistant is thinking (day/night twins; >= 3:1 vs the pill's
         primaryContainer fill in both themes — pinned in StatusContrastTest). -->
    <color name="jarvis_accent_thinking_border">#8A5600</color>

    <!-- Alarm ringing screen: deep, calm, high-contrast -->
    <color name="jarvis_night_scrim">#EE0E1514</color>
    <color name="jarvis_ringing_surface">#0E1514</color>

    <!-- Launcher icon background (adaptive icon solid fallback) — converged
         onto jarvis_primary so the icon and the app read as one palette. -->
    <color name="ic_launcher_background">#00695C</color>
</resources>
