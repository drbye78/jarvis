<?xml version="1.0" encoding="utf-8"?>
<!-- Shared dimensions.
     Touch/height minimums follow the accessibility guidance (48dp) and
     Material button metrics, so fixed pixel heights become minimums that a
     large font scale can grow. -->
<resources>
    <!-- Minimum interactive touch target (Material / WCAG 2.5.8). -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Prominent primary/secondary action height; a minimum, not a cap. -->
    <dimen name="button_min_height">56dp</dimen>
</resources>
