<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared text appearances. Referenced as style="@style/TextAppearance..." -->
    <style name="TextAppearance.Jarvis.AppTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Jarvis.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Compact section label inside cards: primary-colored, tracked-out caps feel -->
    <style name="TextAppearance.Jarvis.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Jarvis.Status" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Jarvis.Hint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Ambient status line (home pill): larger than the old Status tier so
         the state reads at arm's length, onSurface like a primary label. -->
    <style name="TextAppearance.Jarvis.StatusAmbient" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!--
      Settings card shell (U1). The same five appearance attributes were
      copy-pasted into all nine cards of activity_settings.xml; this style is
      their single definition. `parent=""` is REQUIRED and load-bearing:
      AAPT treats the dots in a style name as implicit inheritance and would
      otherwise demand a `Widget.Jarvis` style that does not exist. Breaking
      that chain also keeps the cards on the exact defaults they already
      relied on, and `layout_width`/`layout_height` stay explicit at each
      call site — a style is not the place to risk a card rendering at zero
      size.
    -->
    <style name="Widget.Jarvis.SettingsCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <!-- Button tiers (UI remediation wave 1). Every tier pins the 48dp touch
         minimum so font-scale growth starts from an accessible base; the
         theme wires them as the default filled/outlined/text styles. -->
    <style name="Widget.Jarvis.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.Jarvis.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.Jarvis.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Prominent action tier (home control bar): taller than the standard
         buttons, per button_min_height. -->
    <style name="Widget.Jarvis.MainButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>
</resources>
