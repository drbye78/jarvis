<?xml version="1.0" encoding="utf-8"?>
<!--
  MCP LOCAL loopback exception.

  `android:usesCleartextTraffic="false"` blocks plain HTTP for the whole app.
  The MCP lane's LOCAL servers are expected to run on the device itself
  (http://127.0.0.1:<port>), and Android's network security config resolves
  per-domain over that global flag. This exception therefore re-enables
  cleartext ONLY for the loopback hosts, while the secure default stays for
  everything else.

  Keep this list loopback-only: `mcp/McpUrlPolicy` permits http/https for
  `McpServerKind.LOCAL` only when the host is loopback, and
  `mcp/McpDnsGuard.forServer(LOCAL)` requires every resolved address to be
  loopback. A non-loopback domain added here would punch a hole the policy
  deliberately forbids. `McpLoopbackSecurityConfigTest` pins both the host set
  and the secure base default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
