# Jarvis live-service integration credentials — REMEDIATION_PLAN Phase 2 (P2.1).
#
# Copy this file to the repo root as `local.secrets.properties` and fill in the
# values. That file is .gitignore'd: NEVER commit it, and never paste the
# values into chat, fixtures, build config, or the APK. The app itself stores
# credentials only in the Android Keystore (util/KeystoreVault).
#
# These are the SAME credentials the app asks for in Settings
# (see util/CredentialsStore.kt — the property names below mirror its fields):
#   - Salute Speech  (streaming ASR + TTS): scope SALUTE_SPEECH_PERS
#   - GigaChat       (LLM chat + embeddings): scope GIGACHAT_API_PERS
# Get both pairs from the Sber AI cloud console (developers.sber.ru).
#
#   - Yandex SpeechKit v3 (streaming ASR + TTS): an API key, no folder id
#     (see util/…/YandexCredentials). Get it from the Yandex Cloud console:
#     service account → API keys → create. The console shows an ID and a
#     secret; only the SECRET is sent to the service.
#
# Environment-variable fallback: every key can also be provided as
# JARVIS_<KEY with dots -> underscores, uppercased>, e.g. JARVIS_SALUTE_CLIENT_ID.
# When both are present the properties file wins; a key counts only when non-blank.

# --- Salute Speech: streaming ASR + TTS (scope SALUTE_SPEECH_PERS) ---
jarvis.salute.clientId=<salute oauth client id>
jarvis.salute.clientSecret=<salute oauth client secret>

# --- GigaChat: LLM chat + embeddings (scope GIGACHAT_API_PERS) ---
jarvis.gigachat.clientId=<gigachat oauth client id>
jarvis.gigachat.clientSecret=<gigachat oauth client secret>

# --- Yandex SpeechKit v3: streaming ASR + TTS (API-key auth, no folder id) ---
# `apiKeyId` is an identifier only — it is NEVER sent to the service and is
# kept solely so a rotated key can be told apart in logs/diagnostics. Only
# `apiKey` (the console's "secret") authenticates, sent as:
#     Authorization: Api-Key <apiKey>
jarvis.yandex.apiKey=<yandex cloud api key secret>
jarvis.yandex.apiKeyId=<yandex cloud api key id>
